<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="/>
        <env name="APP_DEBUG" value="true"/>
        <env name="APP_URL" value="http://localhost"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="test-db"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="ndn_testing"/>
        <env name="DB_USERNAME" value="ndn"/>
        <env name="DB_PASSWORD" value="ndn"/>
        <env name="DB_SSLMODE" value="prefer"/>
        <env name="CACHE_STORE" value="file"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="file"/>
        <env name="BROADCAST_CONNECTION" value="log"/>
        <env name="MAIL_MAILER" value="log"/>
    </php>
</phpunit>
